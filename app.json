{
  "expo": {
    "name": "TrajectAI",
    "slug": "traject-ai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trajectaimobile",
    "userInterfaceStyle": "automatic",
    "description": "Hybrid GPS + AI Trajectory Prediction Mobile Application",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trajectai.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TrajectAI needs your location to track your GPS trajectory and provide predictions.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "TrajectAI needs your location to track your GPS trajectory and provide predictions.",
        "NSMotionUsageDescription": "TrajectAI uses motion data to enhance trajectory predictions.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.trajectai.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "BODY_SENSORS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "android.intent.action.VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "trajectai.app"
            }
          ],
          "category": [
            "android.intent.category.BROWSABLE",
            "android.intent.category.DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "145869cb-abaa-4bd9-9c9f-5b80d6791129"
      }
    }
  }
}
