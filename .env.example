# TrajectAI Mobile - Environment Configuration
# Copy this to .env and update values as needed

# API Configuration (for future backend integration)
REACT_APP_API_URL=http://localhost:3000
REACT_APP_API_TIMEOUT=30000

# Model Configuration
REACT_APP_MODEL_PATH=./assets/model/model.json

# Feature Flags
REACT_APP_ENABLE_DEBUG_MODE=false
REACT_APP_ENABLE_SENSOR_FUSION=false
REACT_APP_ENABLE_BACKGROUND_TRACKING=false

# Analytics (optional)
REACT_APP_ANALYTICS_ENABLED=false

# App Version
REACT_APP_VERSION=1.0.0
